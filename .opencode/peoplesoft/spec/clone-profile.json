      "fields": [{"key":"principal","label":"角色／Permission List／主體"},{"key":"resource","label":"受控頁面／資料"},{"key":"operation","label":"操作"},{"key":"condition","label":"允許條件"},{"key":"dataScope","label":"資料範圍"},{"key":"denial","label":"拒絕行為"},{"key":"enforcement","label":"檢查位置／時機"}]
