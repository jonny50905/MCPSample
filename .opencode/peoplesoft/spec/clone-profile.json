      "fields": [{"key":"page","label":"頁面／位置"},{"key":"field","label":"欄位／控制"},{"key":"label","label":"顯示文字"},{"key":"searchKeys","label":"Search keys／查詢條件"},{"key":"scrollLevel","label":"Scroll level／父子列"},{"key":"dataType","label":"型別／格式／長度"},{"key":"valueDomain","label":"值域與儲存值"},{"key":"valueSource","label":"值來源／Prompt／Translate"},{"key":"defaultValue","label":"預設值／時機"},{"key":"nullBehavior","label":"空字串／NULL 差異"},{"key":"required","label":"必填條件"},{"key":"visibility","label":"顯示／隱藏條件"},{"key":"editability","label":"可編輯／唯讀條件"},{"key":"dependencies","label":"欄位依賴與重算"},{"key":"events","label":"事件與欄位連動"},{"key":"validation","label":"檢核與訊息"}]
