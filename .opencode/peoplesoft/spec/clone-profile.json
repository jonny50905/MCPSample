      "fields": [{"key":"scenario","label":"情境"},{"key":"actor","label":"操作者"},{"key":"preconditions","label":"前置條件"},{"key":"sequence","label":"步驟順序"},{"key":"branches","label":"條件分支"},{"key":"postconditions","label":"後置條件"},{"key":"sideEffects","label":"資料／外部副作用"},{"key":"errors","label":"失敗與恢復"},{"key":"excludedPath","label":"排除路徑與邊界"}]
