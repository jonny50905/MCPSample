{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ps-sdoc:schema:status-round2",
  "title": "狀態圖解讀第 2 輪的回答",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "reader",
    "round",
    "source",
    "answers"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^clone-[0-9a-f]{16}$"
    },
    "reader": {
      "type": "string",
      "pattern": "^R[1-3]$"
    },
    "round": {
      "const": 2
    },
    "source": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
        },
        "fingerprint": {
          "$ref": "urn:ps-spec:schema:common#/$defs/sha256"
        }
      },
      "required": [
        "ref",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[0-9]{2,}$"
          },
          "answer": {
            "type": "string",
            "enum": [
              "YES",
              "NO",
              "UNSURE"
            ]
          },
          "note": {
            "$ref": "urn:ps-spec:schema:common#/$defs/text"
          }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
