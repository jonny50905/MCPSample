{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ps-sdoc:schema:l5-answers",
  "title": "乾淨讀者的答案（L5）",
  "description": "讀者只依渲染出的文件作答。文件沒寫的答 NOT_IN_SPEC；ANSWERED 必須引用文件段落（<檔名>#<項目 ID>），答案裡的每個 ID 都要出現在引用的段落裡。",
  "type": "object",
  "required": ["schemaVersion", "jobId", "attemptId", "reader", "round", "batch", "inputHash", "answers"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "pattern": "^clone-[0-9a-f]{16}$" },
    "attemptId": { "type": "string", "pattern": "^a[0-9]{4,8}$" },
    "reader": { "type": "string", "pattern": "^R[1-3]$" },
    "round": { "type": "integer", "minimum": 1, "maximum": 2 },
    "batch": { "type": "string", "pattern": "^b[0-9a-f]{12}$" },
    "inputHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "ids", "kind", "text", "citations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z]+-\\d{3,}/[A-Z][0-9]$", "description": "題目 ID（工單 questions 的 id）" },
          "status": { "type": "string", "enum": ["ANSWERED", "NOT_IN_SPEC"] },
          "ids": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]+-\\d{3,}$" }, "description": "構成答案的規格項目 ID（依題目的 ask）" },
          "kind": { "type": "string", "maxLength": 200, "description": "題目要求的代碼；不需要時寫空字串" },
          "text": { "type": "string", "maxLength": 2000, "description": "用文字寫的答案" },
          "citations": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]{2}-[a-z-]+\\.md#[A-Z]+-\\d{3,}$" }, "description": "引用的段落：<檔名>#<項目 ID>" }
        },
        "additionalProperties": false,
        "allOf": [
          { "if": { "properties": { "status": { "const": "ANSWERED" } } }, "then": { "properties": { "text": { "minLength": 1 }, "citations": { "minItems": 1 } } } }
        ]
      }
    }
  },
  "additionalProperties": false
}
