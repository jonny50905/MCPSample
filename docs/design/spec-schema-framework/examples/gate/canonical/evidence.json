      "excerpt": "TW_DEMO_CASE: TW_DEMO_OFFICER, TW_DEMO_SUPV\nTW_DEMO_DOCREV: TW_DEMO_REVIEWER\nTW_DEMO_PAYMNT: TW_DEMO_ACCT"
    },
    {
      "id": "EV-0004",
      "kind": "SQL",
      "locator": "SELECT CASE_STATUS, COUNT(*) FROM PS_TW_DEMO_CASE GROUP BY CASE_STATUS",
      "excerpt": "010|14  040|37  050|9  060|393  090|21"
    },
    {
      "id": "EV-0005",
      "kind": "SQL",
      "locator": "SELECT APV_STATUS, COUNT(*) FROM PS_TW_DEMO_CASE WHERE CASE_STATUS IN ('050','060') GROUP BY APV_STATUS",
      "excerpt": "010|9  090|393"
    },
    {
      "id": "EV-0006",
      "kind": "SQL",
      "locator": "SELECT DOC_STATUS, COUNT(*) FROM PS_TW_DEMO_CASEDOC GROUP BY DOC_STATUS",
      "excerpt": "010|52  090|1311"
    },
    {
      "id": "EV-0007",
      "kind": "SQL",
      "locator": "SELECT PAY_STATUS, COUNT(*) FROM PS_TW_DEMO_CASEPAY GROUP BY PAY_STATUS",
      "excerpt": "010|18  090|655"
    },
    {
      "id": "EV-0008",
      "kind": "SQL",
      "locator": "SELECT SUM(CASE WHEN NOT EXISTS (SELECT 1 FROM PS_TW_DEMO_CASEDOC D WHERE D.CASE_ID = C.CASE_ID) THEN 1 ELSE 0 END), SUM(CASE WHEN NOT EXISTS (SELECT 1 FROM PS_TW_DEMO_CASEPAY P WHERE P.CASE_ID = C.CASE_ID) THEN 1 ELSE 0 END) FROM PS_TW_DEMO_CASE C WHERE C.CASE_STATUS IN ('050','060')",
      "excerpt": "0|117"
    },
    {
      "id": "EV-0009",
      "kind": "CHUNK",
      "locator": "8801940e-31f2-1d3b-cb04-75236d5db7e2",
      "excerpt": "SQLExec(\"SELECT COUNT(*), SUM(CASE WHEN DOC_STATUS <> '090' THEN 1 ELSE 0 END) FROM PS_TW_DEMO_CASEDOC WHERE CASE_ID = :1\", &caseId, &nDoc, &openDoc);\nSQLExec(\"SELECT COUNT(*) FROM PS_TW_DEMO_CASEPAY WHERE CASE_ID = :1 AND PAY_STATUS <> '090'\", &caseId, &openPay);"
    },
    {
      "id": "EV-0010",
      "kind": "CHUNK",
      "locator": "5f290af9-0a3a-0673-d338-14875cc1e71d",
      "excerpt": "If &caseStatus = \"040\" And &nDoc > 0 And &openDoc = 0 And &openPay = 0 And All(&rptAtt) Then\n   SQLExec(\"UPDATE PS_TW_DEMO_CASE SET CASE_STATUS = '050', APV_STATUS = '010' WHERE CASE_ID = :1\", &caseId);\nEnd-If;"
    },
    {
      "id": "EV-0011",
      "kind": "CHUNK",
      "locator": "0ca5a0ec-34f9-9578-aa12-87b39a9cb5ff",
      "excerpt": "TW_DEMO_DOCREV.SavePostChange: TW_DEMO_CHKCLOSE(TW_DEMO_CASEDOC.CASE_ID);\nTW_DEMO_PAYMNT.SavePostChange: TW_DEMO_CHKCLOSE(TW_DEMO_CASEPAY.CASE_ID);\nTW_DEMO_CASE.SavePostChange: TW_DEMO_CHKCLOSE(TW_DEMO_CASE.CASE_ID);"
    },
    {
      "id": "EV-0012",
      "kind": "CHUNK",
      "locator": "9d999f91-ceac-938b-176d-93024b6e8249",
      "excerpt": "TW_DEMO_CASEWRK.APVOK_PB.FieldChange:\nIf TW_DEMO_CASE.CASE_STATUS <> \"050\" Then Error ...; End-If;\nTW_DEMO_CASE.APV_STATUS.Value = \"090\"; TW_DEMO_CASE.CASE_STATUS.Value = \"060\"; TW_DEMO_CASE.CLOSE_DT.Value = %Date;\nTW_DEMO_SENDCLOSEMAIL(TW_DEMO_CASE.CASE_ID);"
    },
    {
      "id": "EV-0013",
      "kind": "CHUNK",
      "locator": "a4cf80e2-5ed1-f9eb-42fe-b19057de60a4",
      "excerpt": "TW_DEMO_CASEWRK.START_PB.FieldChange:\nTW_DEMO_CASE.CASE_STATUS.Value = \"040\";"
    },
    {
      "id": "EV-0014",
      "kind": "CHUNK",
      "locator": "fb3127ed-dd32-383d-ef84-be5ed247f20d",
      "excerpt": "TW_DEMO_CASEWRK.CANCEL_PB.FieldChange:\nTW_DEMO_CASE.CASE_STATUS.Value = \"090\"; /* 文件與付款列不變更 */"
    },
    {
      "id": "EV-0015",
      "kind": "CHUNK",
      "locator": "74017460-d135-e174-0a78-ce1712bf8a81",
      "excerpt": "TW_DEMO_CASE.SaveEdit:\nIf TW_DEMO_CASE.CASE_STATUS <> \"040\" And (新增了文件或付款列) Then Error MsgGet(27100, 1, \"案件不是處理中，不能新增文件或付款。\"); End-If;"
    },
    {
      "id": "EV-0016",
      "kind": "CHUNK",
      "locator": "8d3f32fb-e5e7-2d44-27a5-e572fa551ab5",
      "excerpt": "TW_DEMO_CASEWRK.DOCOK_PB.FieldChange:\nIf TW_DEMO_CASE.CASE_STATUS <> \"040\" Then Error ...; End-If;\nTW_DEMO_CASEDOC.DOC_STATUS.Value = \"090\";"
    },
    {
      "id": "EV-0017",
      "kind": "CHUNK",
      "locator": "327820ab-6a7f-ca3e-d9d0-29aa8316462b",
      "excerpt": "TW_DEMO_CASEWRK.PAYOK_PB.FieldChange:\nIf TW_DEMO_CASE.CASE_STATUS <> \"040\" Then Error ...; End-If;\nTW_DEMO_CASEPAY.PAY_STATUS.Value = \"090\";"
    },
    {
      "id": "EV-0018",
      "kind": "CHUNK",
      "locator": "27cc1e67-a5f9-0d6d-4a83-91c7c5af5a48",
      "excerpt": "TW_DEMO_CASE.CLOSE_RPT_ATT 附件上傳完成後寫入附件 ID；\nTW_DEMO_CASEWRK.ATTACH_PB 只在 CASE_STATUS = \"040\" 時可用"
