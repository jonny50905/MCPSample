  "statusTexts": [
    {
      "locator": "status-CASE_STATUS.md#L3",
      "text": "本檔是 STATUS 權威文件的合成範例：主業務的每個階段畫成大框框，框內以平行區塊畫子業務，大框框之間的線上寫明往下走的條件。",
      "disposition": "NO_SPEC_CONTENT",
      "note": "說明這份檔案的畫法，沒有規格內容。"
    },
    {
      "locator": "status-CASE_STATUS.md#L70",
      "text": "文件審查另有獨立的圖，內容與大圖 040 的第一個區塊相同。",
      "disposition": "NO_SPEC_CONTENT",
      "note": "說明圖的位置；兩段圖是否一致由外環比對。"
    },
    {
      "locator": "status-CASE_STATUS.md#L89",
      "text": "040 處理中：承辦人追蹤文件審查與付款，並上傳結案報告。",
      "disposition": "MAPPED",
      "items": [
        "ACT-004",
        "ACT-005"
      ]
    },
    {
      "locator": "status-CASE_STATUS.md#L90",
      "text": "文件審查 010 待審查：審查人員逐份審查文件。",
      "disposition": "MAPPED",
      "items": [
        "ACT-002"
      ]
    },
    {
      "locator": "status-CASE_STATUS.md#L91",
      "text": "付款 010 待付款：會計人員依核定金額付款。",
      "disposition": "MAPPED",
      "items": [
        "ACT-003"
      ]
    },
    {
      "locator": "status-CASE_STATUS.md#L92",
      "text": "050 結案審核：主管確認案件資料完整後按「覆核完成」。",
      "disposition": "MAPPED",
      "items": [
        "ACT-001"
      ]
    },
    {
      "locator": "status-CASE_STATUS.md#L93",
      "text": "結案後由系統寄發結案通知給承辦人。",
      "disposition": "MAPPED",
      "items": [
        "TRN-012"
      ],
      "note": "系統的副作用，寫在 050→060 轉移的 sideEffects。"
    }
  ],
