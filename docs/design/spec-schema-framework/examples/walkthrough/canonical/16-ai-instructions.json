      "lifecycle": "ACTIVE",
      "basis": "TEMPLATE",
      "certainty": "CONFIRMED",
      "evidence": [],
      "category": "DATA",
      "clause": "狀態碼、選項儲存值、訊息原文一律保留原值；畫面文字可以調整，但不得更改儲存值。"
    },
    {
      "id": "AI-005",
