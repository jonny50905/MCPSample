    {
      "id": "EV-0016",
      "kind": "CHUNK",
      "locator": "9749aec1-b169-4a6e-0a4f-f9bb9edd1ae8",
      "excerpt": "&sup = TW_DEMO_GETSUPERVISOR(TW_DEMO_REQHDR.REQUESTER_EMPLID);\nIf None(&sup) Then Error MsgGet(27000, 3, \"找不到直屬主管，無法送出。\"); End-If;\nTW_DEMO_REQHDR.REQ_STATUS.Value = \"020\";\nTW_DEMO_REQHDR.SUBMIT_DT.Value = %Date;"
    },
    {
      "id": "EV-0017",
      "kind": "CHUNK",
      "locator": "a8c1e14d-5f72-d369-91f0-b0c458407f19",
      "excerpt": "TW_DEMO_REQHDR.REQ_STATUS.Value = \"090\";"
    },
    {
      "id": "EV-0018",
      "kind": "CHUNK",
      "locator": "0d43ec68-7e00-e634-4cc7-e1dfde4ad337",
      "excerpt": "If TW_DEMO_REQHDR.REQ_STATUS = \"020\" And TW_DEMO_REQHDR.AMOUNT > 50000 Then\n   TW_DEMO_REQHDR.REQ_STATUS.Value = \"025\";\nElse\n   TW_DEMO_REQHDR.REQ_STATUS.Value = \"030\"; TW_DEMO_REQHDR.APPROVER_EMPLID.Value = %EmployeeId; TW_DEMO_REQHDR.APPROVE_DT.Value = %Date;\nEnd-If;"
    },
    {
      "id": "EV-0019",
      "kind": "CHUNK",
      "locator": "422e08e9-6536-e965-9c9c-01d43a181f47",
      "excerpt": "If TW_DEMO_REQHDR.REQ_STATUS = \"020\" And &sup <> %EmployeeId Then Error ...;\nIf TW_DEMO_REQHDR.REQ_STATUS = \"025\" And &mgr <> %EmployeeId Then Error ...;"
    },
    {
      "id": "EV-0020",
      "kind": "CHUNK",
      "locator": "22c168df-3068-e7c2-caa4-a8529a7e6f79",
      "excerpt": "If None(TW_DEMO_REQHDR.COMMENTS) Then Error MsgGet(27000, 2, \"退回時必須填寫審核意見。\"); End-If;\nTW_DEMO_REQHDR.REQ_STATUS.Value = \"015\";"
    },
    {
      "id": "EV-0021",
      "kind": "CHUNK",
      "locator": "a59851d4-2fe6-e2c9-df79-5b78c7fe373e",
      "excerpt": "If TW_DEMO_REQHDR.AMOUNT <= 0 Then\n   Error MsgGet(27000, 1, \"金額必須大於 0。\");\nEnd-If;"
    },
    {
      "id": "EV-0022",
      "kind": "CHUNK",
      "locator": "4c3e0c29-409a-f0a7-a673-8950a6a7db11",
      "excerpt": "If TW_DEMO_REQHDR.REQ_TYPE = \"INT\" Then\n   Exit(1); /* 內部申請不檢查金額 */\nEnd-If;"
    },
    {
      "id": "EV-0023",
      "kind": "SQL",
      "locator": "SELECT REQ_TYPE, COUNT(*) FROM PS_TW_DEMO_REQHDR GROUP BY REQ_TYPE",
      "excerpt": "GEN|900  URG|312"
    },
    {
      "id": "EV-0024",
      "kind": "SQL",
      "locator": "SELECT FIELDVALUE, EFF_STATUS FROM PSXLATITEM WHERE FIELDNAME = 'REQ_TYPE'",
      "excerpt": "GEN|A  URG|A  INT|I"
    },
    {
      "id": "EV-0025",
      "kind": "SQL",
      "locator": "SELECT OBJECTVALUE1, OBJECTVALUE2, OBJECTVALUE3 FROM PSPCMNAME WHERE RECNAME = 'TW_DEMO_REQHDR' AND REFNAME = 'REQ_TYPE'",
      "excerpt": "TW_DEMO_REQHDR|AMOUNT|SaveEdit"
    },
    {
      "id": "EV-0026",
      "kind": "CHUNK",
      "locator": "27d93e89-afa8-3da4-4a01-9b846fd5c6fb",
      "excerpt": "If None(TW_DEMO_REQHDR.REQUESTER_EMPLID) Then TW_DEMO_REQHDR.REQUESTER_EMPLID = %EmployeeId; End-If;"
    },
    {
      "id": "EV-0027",
      "kind": "CHUNK",
      "locator": "31848d0f-5c33-ee89-ac25-89ce41510031",
      "excerpt": "If TW_DEMO_REQHDR.REQ_ID = \"NEW\" Then\n   TW_DEMO_REQHDR.REQ_ID = TW_DEMO_NEXTREQID();\nEnd-If;"
    },
    {
      "id": "EV-0028",
      "kind": "CHUNK",
      "locator": "a52c73e0-f63e-c571-569c-1d0c03234e97",
      "excerpt": "If TW_DEMO_REQHDR.REQ_STATUS = \"020\" Then\n   TW_DEMO_SCHEDNOTIFY(TW_DEMO_REQHDR.REQ_ID);\nEnd-If;"
    },
    {
      "id": "EV-0029",
      "kind": "CHUNK",
      "locator": "13835936-c32b-5c08-dc51-eda7728e0ad3",
      "excerpt": "If %Request.GetParameter(\"REOPEN\") = \"Y\" And TW_DEMO_REQHDR.REQ_STATUS = \"030\" Then\n   TW_DEMO_REQHDR.REQ_STATUS.Value = \"010\";\nEnd-If;"
    },
    {
      "id": "EV-0030",
      "kind": "CHUNK",
      "locator": "06323a06-d258-ee9b-4140-2ae46d8d54f1",
      "excerpt": "SQLExec(\"SELECT SUPERVISOR_ID FROM PS_TW_DEMO_EMP E WHERE EMPLID = :1 AND EFF_STATUS = 'A' AND EFFDT = (SELECT MAX(EFFDT) FROM PS_TW_DEMO_EMP WHERE EMPLID = E.EMPLID AND EFFDT <= %CurrentDateIn)\", &emplid, &sup);"
    },
    {
      "id": "EV-0031",
      "kind": "CHUNK",
      "locator": "c4132e9c-d9b0-fb8d-ccac-22e4f83f199c",
      "excerpt": "SQLExec(\"SELECT D.MANAGER_ID FROM PS_TW_DEMO_EMP E, PS_TW_DEMO_DEPT D WHERE ... current EFFDT rows ... AND D.DEPTID = E.DEPTID\", &emplid, &mgr);"
    },
    {
      "id": "EV-0032",
      "kind": "CHUNK",
      "locator": "888c4b84-6157-afd1-f62b-fe6c3b98e804",
      "excerpt": "If TW_DEMO_REQHDR.LASTUPDDTTM <> &loadedDttm Then Error MsgGet(27000, 4, \"此申請單已被其他使用者更新，請重新查詢。\"); End-If;"
    },
    {
      "id": "EV-0033",
      "kind": "CHUNK",
      "locator": "aba1b504-3b10-cb68-5c9b-95ef6d7a49fc",
      "excerpt": "SELECT REQ_ID, REQUESTER_EMPLID, AMOUNT FROM PS_TW_DEMO_REQHDR WHERE REQ_ID = %Bind(REQ_ID)\n-- send mail to supervisor; on failure write process log only"
    },
    {
      "id": "EV-0034",
      "kind": "CHUNK",
      "locator": "85d4cb82-b319-3bdc-be99-8ddeb0b8ab2a",
      "excerpt": "If TW_DEMO_REQHDR.REQ_STATUS = \"010\" Or TW_DEMO_REQHDR.REQ_STATUS = \"015\" Then\n   TW_DEMO_REQWRK.SUBMIT_PB.Visible = True; TW_DEMO_REQWRK.WITHDRAW_PB.Visible = True;\nElse ... Visible = False; TW_DEMO_REQHDR.AMOUNT.DisplayOnly = True; End-If;"
    },
    {
      "id": "EV-0035",
      "kind": "CHUNK",
      "locator": "a9b03b7a-db11-866d-8e94-ef8627556681",
      "excerpt": "If TW_DEMO_REQHDR.REQ_STATUS = \"020\" Or TW_DEMO_REQHDR.REQ_STATUS = \"025\" Then\n   TW_DEMO_REQWRK.APPROVE_PB.Visible = True; TW_DEMO_REQWRK.RETURN_PB.Visible = True;\nElse ... Visible = False; End-If;"
    },
