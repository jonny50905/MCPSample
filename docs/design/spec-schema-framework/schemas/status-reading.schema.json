{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ps-spec:schema:status-reading",
  "title": "狀態圖解讀（讀者的研究包）",
  "description": "每一位讀者各寫一份。Mermaid 區塊內每一行恰好交代一次：被狀態、子業務或轉移引用，或列在 otherLines。",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "reader",
    "round",
    "source",
    "states",
    "transitions",
    "otherLines",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^clone-[0-9a-f]{16}$"
    },
    "reader": {
      "type": "string",
      "pattern": "^R[1-3]$"
    },
    "round": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
        },
        "fingerprint": {
          "$ref": "urn:ps-spec:schema:common#/$defs/sha256"
        }
      },
      "required": [
        "ref",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "$ref": "urn:ps-spec:schema:common#/$defs/slug"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{3}$"
          },
          "name": {
            "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
          },
          "final": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity": {
                  "$ref": "urn:ps-spec:schema:common#/$defs/slug"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "entity",
                "lines"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "entity",
          "code",
          "name",
          "final",
          "lines",
          "regions"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "$ref": "urn:ps-spec:schema:common#/$defs/slug"
          },
          "from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{3}$"
              },
              {
                "const": "*"
              }
            ]
          },
          "to": {
            "type": "string",
            "pattern": "^\\d{3}$"
          },
          "via": {
            "type": "array",
            "items": {
              "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
            }
          },
          "labels": {
            "type": "array",
            "items": {
              "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
            }
          },
          "scenario": {
            "anyOf": [
              {
                "$ref": "urn:ps-spec:schema:common#/$defs/rawText"
              },
              {
                "type": "null"
              }
            ]
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "entity",
          "from",
          "to",
          "via",
          "labels",
          "scenario",
          "lines"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "otherLines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "disposition": {
            "type": "string",
            "enum": [
              "NO_SPEC_CONTENT",
              "TEXT"
            ]
          },
          "note": {
            "$ref": "urn:ps-spec:schema:common#/$defs/text"
          },
          "entity": {
            "$ref": "urn:ps-spec:schema:common#/$defs/slug"
          },
          "code": {
            "type": "string",
            "pattern": "^\\d{3}$"
          }
        },
        "required": [
          "lines",
          "disposition"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "NO_SPEC_CONTENT"
                }
              }
            },
            "then": {
              "required": [
                "note"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "entity"
                    ]
                  },
                  {
                    "required": [
                      "code"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "$ref": "urn:ps-spec:schema:common#/$defs/text"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "description",
          "lines"
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
